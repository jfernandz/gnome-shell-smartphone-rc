<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.smartphone-rc" path="/org/gnome/shell/extensions/smartphone-rc/">
    <key name="sensitivity-min" type="d">
      <default>0.5</default>
      <range min="0.5" max="19.5"/>
      <summary>Minimum pointer sensitivity</summary>
    </key>
    <key name="sensitivity-max" type="d">
      <default>10.0</default>
      <range min="1.0" max="20.0"/>
      <summary>Maximum pointer sensitivity</summary>
    </key>
    <key name="trust-duration-days" type="u">
      <default>90</default>
      <range min="7" max="90"/>
      <summary>Lifetime of newly remembered browser credentials in days</summary>
    </key>
    <key name="trust-generation" type="s">
      <default>''</default>
      <summary>Generation of valid remembered-browser grants</summary>
    </key>
    <key name="trusted-browsers" type="s">
      <default>'[]'</default>
      <summary>Remembered-browser enrollment grants</summary>
      <description>Contains verifiers and enrollment snapshots, never raw credentials. Per-browser revocation and metadata use independent settings; Forget all advances the trust generation.</description>
    </key>
  </schema>
</schemalist>
